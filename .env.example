# Copy to `.env` and fill in real values: `cp .env.example .env`
# `.env` is git-ignored — never commit real secrets.
#
# This covers local/dev usage (docker-compose reads `.env` via `env_file:`
# on api/worker). For production, prefer Docker secrets or a mounted
# secrets file over baking values into `.env` inside an image — see the
# "Secrets in production" section of README.md and ARCHITECTURE.md §5.

# --- App ---
NODE_ENV=development
# Single-currency MVP (ADR-0001) — no per-account currency conversion.
BASE_CURRENCY=USD

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/ai-financial-os

# --- Redis / BullMQ ---
REDIS_URL=redis://redis:6379

# --- Plaid ---
# https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- OpenAI (Tier 3 LLM categorization, ARCHITECTURE.md §2.3) ---
OPENAI_API_KEY=

# --- Reverse proxy (proxy/Caddyfile) ---
# Domain for automatic Let's Encrypt TLS. Leave unset (or "localhost") for
# local development — Caddy issues a locally-trusted cert automatically.
DOMAIN=localhost
