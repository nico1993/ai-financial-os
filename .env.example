# Run `bash dev-setup.sh` to generate a working `.env` (it creates
# SESSION_SECRET locally), or copy this file and fill it in by hand.
# `.env` is git-ignored — never commit real secrets.
#
# Two different mechanisms read this file, which is worth knowing when a
# var appears "missing":
#   - In Docker, compose injects it via `env_file:` on api/worker. Note
#     that compose ALSO pins MONGO_URI/REDIS_URL to the internal service
#     names via `environment:`, overriding whatever is set here.
#   - On the host (`pnpm dev` / `pnpm start`, which run under tsx),
#     nothing injects anything — each app's `src/env.ts` calls dotenv
#     against this file explicitly. Real environment variables always win
#     over it, so containers and CI are unaffected.
#
# For production, prefer Docker secrets or a mounted secrets file over
# baking values into `.env` inside an image — see the "Secrets in
# production" section of README.md and ARCHITECTURE.md §5. `.dockerignore`
# keeps `.env` out of the build context so this can't happen by accident.

# --- App ---
NODE_ENV=development
# Single-currency MVP (ADR-0001) — no per-account currency conversion.
BASE_CURRENCY=USD
PORT=3000

# --- Auth (ADR-0018) ---
# Signs the session cookie — generate with `openssl rand -base64 48`.
# Must be at least 32 characters.
SESSION_SECRET=

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/ai-financial-os

# --- Redis / BullMQ / sessions ---
REDIS_URL=redis://redis:6379
# How many provider-sync jobs apps/worker runs at once. Each one is a
# multi-page Plaid drain and Plaid rate-limits per Item, so keep this low.
PROVIDER_SYNC_CONCURRENCY=2
# Client-side rate ceiling on the provider-sync queue: at most
# PROVIDER_SYNC_RATE_MAX jobs started per PROVIDER_SYNC_RATE_DURATION_MS.
# Keeps a burst of webhooks from walking straight into a Plaid 429.
PROVIDER_SYNC_RATE_MAX=5
PROVIDER_SYNC_RATE_DURATION_MS=1000
# Fallback poll interval (ING-8) — the safety net for a missed webhook.
# ARCHITECTURE.md §2.2 suggests 4–6h; default is 4h.
PROVIDER_SYNC_POLL_INTERVAL_MS=14400000

# --- Plaid ---
# https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Shown in the Plaid Link UI ("connect to <name>").
PLAID_CLIENT_NAME=Personal Financial OS
# Plaid webhook receiver (ING-7). Leave unset in local dev if no public
# URL is reachable — ING-8's polling fallback covers ingestion meanwhile.
PLAID_WEBHOOK_URL=

# --- Ollama (Tier 3 LLM categorization, ARCHITECTURE.md §2.3, ADR-0026) ---
# CategorizationProvider abstracts the LLM backend; Ollama running gpt-oss:20b
# locally is Phase 1's implementation, not a hardcoded assumption -- swap
# OLLAMA_MODEL for a different pulled model with no code change. No API key:
# Ollama has none. Run `ollama serve` and `ollama pull gpt-oss:20b` before
# starting apps/worker.
#
# This default (localhost) is for apps/worker running on the host under
# `pnpm dev`/tsx. Inside the Docker Compose network, docker-compose.yml
# overrides this to http://host.docker.internal:11434 the same way it pins
# MONGO_URI/REDIS_URL above -- Ollama runs natively on the host, not as a
# compose service, so "localhost" from inside a container would mean the
# container itself.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
# Transactions per categorizeBatch() call (ARCHITECTURE.md §2.3 suggests 20-50).
CATEGORIZE_LLM_BATCH_SIZE=30
# CAT-5's confirmed/needs_review split, inclusive -- a result exactly at the
# threshold confirms.
CATEGORIZE_LLM_CONFIDENCE_THRESHOLD=0.7
# How many categorize-llm jobs (one per user) run at once. Kept at 1 by
# default: unlike PROVIDER_SYNC_CONCURRENCY, this is bounded by one
# machine's GPU/unified memory, not by a remote API's rate limit.
CATEGORIZE_LLM_CONCURRENCY=1

# --- Reverse proxy (proxy/Caddyfile) ---
# Domain for automatic Let's Encrypt TLS. Leave unset (or "localhost") for
# local development — Caddy issues a locally-trusted cert automatically.
DOMAIN=localhost
