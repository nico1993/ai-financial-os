# Copy to `.env` and fill in real values: `cp .env.example .env`
# `.env` is git-ignored — never commit real secrets.
#
# This covers local/dev usage (docker-compose reads `.env` via `env_file:`
# on api/worker). For production, prefer Docker secrets or a mounted
# secrets file over baking values into `.env` inside an image — see the
# "Secrets in production" section of README.md and ARCHITECTURE.md §5.

# --- App ---
NODE_ENV=development
# Single-currency MVP (ADR-0001) — no per-account currency conversion.
BASE_CURRENCY=USD
PORT=3000

# --- Auth (ADR-0018) ---
# Signs the session cookie — generate with `openssl rand -base64 48`.
# Must be at least 32 characters.
SESSION_SECRET=

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/ai-financial-os

# --- Redis / BullMQ / sessions ---
REDIS_URL=redis://redis:6379
# How many provider-sync jobs apps/worker runs at once. Each one is a
# multi-page Plaid drain and Plaid rate-limits per Item, so keep this low.
PROVIDER_SYNC_CONCURRENCY=2
# Client-side rate ceiling on the provider-sync queue: at most
# PROVIDER_SYNC_RATE_MAX jobs started per PROVIDER_SYNC_RATE_DURATION_MS.
# Keeps a burst of webhooks from walking straight into a Plaid 429.
PROVIDER_SYNC_RATE_MAX=5
PROVIDER_SYNC_RATE_DURATION_MS=1000
# Fallback poll interval (ING-8) — the safety net for a missed webhook.
# ARCHITECTURE.md §2.2 suggests 4–6h; default is 4h.
PROVIDER_SYNC_POLL_INTERVAL_MS=14400000

# --- Plaid ---
# https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Shown in the Plaid Link UI ("connect to <name>").
PLAID_CLIENT_NAME=Personal Financial OS
# Plaid webhook receiver (ING-7). Leave unset in local dev if no public
# URL is reachable — ING-8's polling fallback covers ingestion meanwhile.
PLAID_WEBHOOK_URL=

# --- OpenAI (Tier 3 LLM categorization, ARCHITECTURE.md §2.3) ---
OPENAI_API_KEY=

# --- Reverse proxy (proxy/Caddyfile) ---
# Domain for automatic Let's Encrypt TLS. Leave unset (or "localhost") for
# local development — Caddy issues a locally-trusted cert automatically.
DOMAIN=localhost
